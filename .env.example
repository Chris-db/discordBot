# Discord Application Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Client/Application ID of the bot
CLIENT_ID=your_client_id_here

# (Optional) Test Guild/Server ID for instant slash command registration during development
GUILD_ID=your_guild_id_here

# SQLite Database File Path
DB_PATH=data/6mans.sqlite

# Default Starting MMR for new players
DEFAULT_MMR=1000

# --- Timeouts (all optional; shown values are the defaults) ---
# Minutes a player can sit in queue before being auto-removed
QUEUE_TIMEOUT_MINUTES=30
# Hours an IN_PROGRESS match can run before it is auto-cancelled (sized for a BO5)
MATCH_TIMEOUT_HOURS=3
# Minutes a match can sit in ready check / voting / drafting before being auto-cancelled
SETUP_TIMEOUT_MINUTES=15
# Seconds a captain has to pick before the highest-MMR player is auto-picked for them
DRAFT_PICK_TIMEOUT_SECONDS=90

# --- Nightly database backups (all optional; shown values are the defaults) ---
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=14
