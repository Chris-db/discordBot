# Discord Application Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Client/Application ID of the bot
CLIENT_ID=your_client_id_here

# (Optional) Test Guild/Server ID for instant slash command registration during development
GUILD_ID=your_guild_id_here

# SQLite Database File Path
DB_PATH=data/6mans.sqlite

# Default Starting MMR for new players
DEFAULT_MMR=1000
