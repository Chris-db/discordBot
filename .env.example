# Discord Application Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Client/Application ID of the bot
CLIENT_ID=your_client_id_here

# (Optional) Test Guild/Server ID for instant slash command registration during development
GUILD_ID=your_guild_id_here

# SQLite Database File Path
DB_PATH=data/6mans.sqlite

# Default Starting MMR for new players
DEFAULT_MMR=1000

# --- Timeouts (all optional; shown values are the defaults) ---
# Minutes a player can sit in queue before being auto-removed
QUEUE_TIMEOUT_MINUTES=30
# Hours an IN_PROGRESS match can run before it is auto-cancelled (sized for a BO5)
MATCH_TIMEOUT_HOURS=3
# Minutes a match can sit in ready check / voting / drafting before being auto-cancelled
SETUP_TIMEOUT_MINUTES=15
# Seconds a captain has to pick before the highest-MMR player is auto-picked for them
DRAFT_PICK_TIMEOUT_SECONDS=90
# Seconds a popped lobby has to get everyone into the ready-check voice channel
READY_CHECK_TIMEOUT_SECONDS=300
# Seconds each setup vote (mode, captains, teams) stays open; silence resolves it
VOTE_TIMEOUT_SECONDS=60

# --- Nightly database backups (all optional; shown values are the defaults) ---
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=14

# --- Uptime heartbeat (optional; off unless HEARTBEAT_URL is set) ---
# A URL the bot pings while its Discord gateway is connected. Point it at a monitor that
# alerts when the pings stop, e.g. a Healthchecks.io check's ping URL.
# HEARTBEAT_URL=https://hc-ping.com/your-check-uuid
# Minutes between pings; set the monitor's expected period to match
HEARTBEAT_INTERVAL_MINUTES=5

# --- Error reports and /feedback to GitHub Issues (optional; off unless both are set) ---
# Every distinct runtime error becomes one issue labelled 'bot-error' (repeats are comments
# on it); every /feedback becomes an issue labelled 'feedback'. Use a fine-grained personal
# access token scoped to this one repository with "Issues: read and write" and nothing else.
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=github_pat_...
# Minimum minutes between two notes about the same error
ERROR_REPORT_COOLDOWN_MINUTES=60

# --- Test bots (optional; off everywhere unless set) ---
# Comma-separated server ids where /queue fill-bots and /queue force-pop may run. The test
# bots get real leaderboard rows, so keep live servers off this list.
# TEST_GUILD_IDS=123456789012345678,234567890123456789
